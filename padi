#!/bin/bash
# PADI CLI - Interactive Development Assistant
# This script starts the PADI server and provides an interactive CLI

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Helper function to capitalize first letter
capitalize() {
    echo "$(echo "$1" | cut -c1 | tr '[:lower:]' '[:upper:]')$(echo "$1" | cut -c2-)"
}

# Get script directory (script is in the PADI project directory)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"

# Check if we're in the PADI project directory
if [ ! -f "$PROJECT_DIR/mix.exs" ]; then
    echo -e "${RED}Error: mix.exs not found. Please run this script from the PADI project directory.${NC}"
    exit 1
fi

# Change to project directory
cd "$PROJECT_DIR"

# Check if Elixir is installed
if ! command -v elixir &> /dev/null; then
    echo -e "${RED}Error: Elixir is not installed. Please install Elixir first.${NC}"
    echo "Visit: https://elixir-lang.org/install.html"
    exit 1
fi

# Check if mix is available
if ! command -v mix &> /dev/null; then
    echo -e "${RED}Error: mix is not available. Please ensure Elixir is properly installed.${NC}"
    exit 1
fi

# Display welcome message
echo -e "${PURPLE}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${PURPLE}║                                                              ║${NC}"
echo -e "${PURPLE}║   ${CYAN}PADI - Interactive Development Assistant${NC}                ${PURPLE}║${NC}"
echo -e "${PURPLE}║                                                              ║${NC}"
echo -e "${PURPLE}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Detect current project
CURRENT_PROJECT_DIR="$(pwd)"
PROJECT_TYPE="unknown"

if [ -f "mix.exs" ]; then
    PROJECT_TYPE="elixir"
    PROJECT_NAME=$(grep -A1 "def project" mix.exs | grep "name:" | sed 's/.*name:\s*://;s/[",]//g' | xargs || basename "$CURRENT_PROJECT_DIR")
elif [ -f "Cargo.toml" ]; then
    PROJECT_TYPE="rust"
    PROJECT_NAME=$(grep "^name = " Cargo.toml | sed 's/name = "\(.*\)"/\1/' || basename "$CURRENT_PROJECT_DIR")
elif [ -f "package.json" ]; then
    PROJECT_TYPE="nodejs"
    PROJECT_NAME=$(grep '"name"' package.json | head -1 | sed 's/.*"name":\s*"\(.*\)".*/\1/' || basename "$CURRENT_PROJECT_DIR")
elif [ -f "requirements.txt" ] || [ -f "setup.py" ] || [ -f "pyproject.toml" ]; then
    PROJECT_TYPE="python"
    PROJECT_NAME=$(basename "$CURRENT_PROJECT_DIR")
elif [ -f "go.mod" ]; then
    PROJECT_TYPE="go"
    PROJECT_NAME=$(grep "^module " go.mod | awk '{print $2}' | xargs basename || basename "$CURRENT_PROJECT_DIR")
elif [ -f "pom.xml" ]; then
    PROJECT_TYPE="java"
    PROJECT_NAME=$(grep "<artifactId>" pom.xml | head -1 | sed 's/.*<artifactId>\(.*\)<\/artifactId>.*/\1/' || basename "$CURRENT_PROJECT_DIR")
fi

if [ "$PROJECT_TYPE" != "unknown" ]; then
    echo -e "${GREEN}✓${NC} Detected ${CYAN}$(capitalize "$PROJECT_TYPE")${NC} project: ${BLUE}${PROJECT_NAME}${NC}"
else
    echo -e "${YELLOW}⚠${NC} No recognized project found in current directory"
    echo -e "  ${YELLOW}→${NC} PADI will start in standalone mode"
fi

echo ""
echo -e "${CYAN}Starting PADI server...${NC}"
echo ""

# Start PADI server and run interactive CLI
# Using mix run to properly start the application
mix run -e "
  # Application is already started by mix run
  # Start the REPL if not already started
  case Process.whereis(Padi.CLI.REPL) do
    nil ->
      {:ok, _pid} = Padi.CLI.REPL.start_link()
    _pid ->
      :ok
  end

  # Get project info
  project_info = Padi.CLI.ProjectDetector.get_project_info()

  # Display welcome banner
  IO.puts(\"\\n\#{IO.ANSI.cyan()}PADI CLI Ready!\#{IO.ANSI.reset()}\")

  if project_info.type != :unknown do
    IO.puts(\"\\n\#{IO.ANSI.green()}✓\#{IO.ANSI.reset()} Project: \#{IO.ANSI.cyan()}\#{project_info.name}\#{IO.ANSI.reset()} (\#{project_info.type})\")
    IO.puts(\"  Path: \#{project_info.path}\")
  end

  IO.puts(\"\\n\#{IO.ANSI.yellow()}Available commands:\#{IO.ANSI.reset()}\")
  IO.puts(\"  • run tests / run unit tests\")
  IO.puts(\"  • build project / compile code\")
  IO.puts(\"  • run the app / start application\")
  IO.puts(\"  • install dependencies\")
  IO.puts(\"  • clean project\")
  IO.puts(\"  • status\")
  IO.puts(\"  • help\")
  IO.puts(\"  • exit\")
  IO.puts(\"\")

  # Main command loop - recursive implementation
  defmodule Padiloop do
    def run_loop do
      input = IO.gets(\"\\n\#{IO.ANSI.purple()}padi>\#{IO.ANSI.reset()} \")

      case input do
        :eof ->
          IO.puts(\"\\nGoodbye!\")

        \"\\n\" ->
          run_loop()

        input ->
          input = String.trim(input)

          case Padi.CLI.REPL.process_command(input) do
            {:exit, message} ->
              IO.puts(\"\\n\#{message}\")

            {:ok, response} when is_binary(response) ->
              IO.puts(\"\\n\#{response}\")
              run_loop()

            {:ok, _result} ->
              run_loop()

            {:error, reason} ->
              IO.puts(\"\\n\#{IO.ANSI.red()}Error:\#{IO.ANSI.reset()} \#{reason}\")
              run_loop()
          end
      end
    end
  end

  # Start the loop
  Padiloop.run_loop()
" --no-start "$@"
